# WiFi-DensePose API Environment Configuration Template
# ----------------------------------------------------------------------
# Copy this file to .env and edit. Defaults are tuned to be SAFE by
# default — loopback binds, auth on, CORS locked to localhost. Flip the
# DANGER-marked toggles at the bottom only after you understand what
# they expose.
# ----------------------------------------------------------------------

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME=WiFi-DensePose API
VERSION=1.0.0
ENVIRONMENT=production           # development | staging | production
DEBUG=false                      # NEVER leave true on a deployed host

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=127.0.0.1                   # Loopback by default. Change ONLY together
                                 # with auth + CORS settings below.
PORT=8000
RELOAD=false                     # NEVER leave true on a deployed host
WORKERS=1

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Server-side bearer token for /api/v1/* and /ws/* (sensing-server crate).
# REQUIRED before binding to anything other than 127.0.0.1.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUVIEW_API_TOKEN=

# nvsim-server bearer token (separate from RUVIEW_API_TOKEN above).
NVSIM_API_TOKEN=

# MAT crate bearer token (when you embed it in your own binary).
MAT_API_TOKEN=

# SECRET_KEY: used for JWT signing in the Python API tier.
# Empty by default — fill in before enabling ENABLE_AUTHENTICATION.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Allowed Host header values. Lock to your exact hostnames in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origins. Wildcard `*` is rejected by nvsim-server unless
# NVSIM_ALLOW_OPEN=1 is also set (intentional safety brake).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# DATABASE SETTINGS
# =============================================================================
# Override before first run. The credentials below are placeholders, NOT
# defaults that ship with a working server. Leave DATABASE_URL empty to
# fall back to SQLite at SQLITE_FALLBACK_PATH.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Individual database connection parameters (if you prefer them split out):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=wifi_densepose
# DB_USER=
# DB_PASSWORD=

ENABLE_DATABASE_FAILSAFE=true
SQLITE_FALLBACK_PATH=./data/wifi_densepose_fallback.db

# =============================================================================
# REDIS SETTINGS (optional)
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=false              # off by default; flip on after you set a password
REDIS_REQUIRED=false
ENABLE_REDIS_FAILSAFE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MAX_CONNECTIONS=10
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# =============================================================================
# HARDWARE SETTINGS
# =============================================================================
WIFI_INTERFACE=wlan0
CSI_BUFFER_SIZE=1000
HARDWARE_POLLING_INTERVAL=0.1

# Mock data is OFF by default so you notice when hardware isn't wired up.
MOCK_HARDWARE=false
MOCK_POSE_DATA=false

# =============================================================================
# POSE ESTIMATION SETTINGS
# =============================================================================
# POSE_MODEL_PATH=/path/to/your/pose/model.pth
POSE_CONFIDENCE_THRESHOLD=0.5
POSE_PROCESSING_BATCH_SIZE=32
POSE_MAX_PERSONS=10

# =============================================================================
# STREAMING SETTINGS
# =============================================================================
STREAM_FPS=30
STREAM_BUFFER_SIZE=100
WEBSOCKET_PING_INTERVAL=60
WEBSOCKET_TIMEOUT=300

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_AUTHENTICATION=true       # Set SECRET_KEY before flipping false
ENABLE_RATE_LIMITING=true
ENABLE_WEBSOCKETS=true
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_HISTORICAL_DATA=true

# Dev/test endpoints (`/__test/*`, etc.). Default off.
ENABLE_TEST_ENDPOINTS=false

# =============================================================================
# RATE LIMITING SETTINGS
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_AUTHENTICATED_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
# LOG_FILE=/var/log/wifi-densepose/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# STORAGE SETTINGS
# =============================================================================
DATA_STORAGE_PATH=./data
MODEL_STORAGE_PATH=./models
TEMP_STORAGE_PATH=./temp
MAX_STORAGE_SIZE_GB=100

# =============================================================================
# MONITORING SETTINGS
# =============================================================================
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30
PERFORMANCE_MONITORING=true

# =============================================================================
# API SETTINGS
# =============================================================================
API_PREFIX=/api/v1
# Disable interactive docs in production by setting these to "null".
DOCS_URL=null
REDOC_URL=null
OPENAPI_URL=null

# =============================================================================
# === DANGER: only-for-trusted-lab toggles ====================================
# =============================================================================
# RUVIEW_ALLOW_OPEN=1   — let sensing-server bind to a non-loopback address
#                         WITHOUT a token. Biometric WebSocket and write
#                         endpoints will be reachable anonymously on the LAN.
# NVSIM_ALLOW_OPEN=1    — let nvsim-server use wildcard CORS / bind non-
#                         loopback without NVSIM_API_TOKEN. Any web page in
#                         the browser can drive the pipeline.
#
# Neither flag is set by default. Flip them only on an air-gapped lab rig.

# =============================================================================
# DEVELOPMENT-PROFILE OVERRIDES (uncomment to opt in, NEVER in production)
# =============================================================================
# ENVIRONMENT=development
# DEBUG=true
# RELOAD=true
# HOST=0.0.0.0
# MOCK_HARDWARE=true
# MOCK_POSE_DATA=true
# ENABLE_AUTHENTICATION=false
# ENABLE_RATE_LIMITING=false
# ENABLE_TEST_ENDPOINTS=true
# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json
# RUVIEW_ALLOW_OPEN=1
# NVSIM_ALLOW_OPEN=1
